        </mxCell>
        <mxCell id="i72__2" value="The enclosing frame is the top module; blocks inside are its instances. The two clock domains are asynchronous: the register side runs on the BUS clock, the protocol side on the CAN clock, and u_canfd_cdc holds the synchronizers and handshakes between them. Connections of u_canfd_pwr, u_canfd_pn, u_canfd_tt, u_canfd_ts, u_canfd_safe and u_canfd_rst to the other blocks are many-to-many and are listed in sections 7 and 18. With PARA_CANFD_SAF_DUP_EN=1, u_canfd_safe also contains the delayed duplicate protocol core (section 18.3.4)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=18;fontColor=#000000;spacing=2;" vertex="1" parent="1" vlsit_library_sha256="D1631ACF98A920526B235E8970FEDDC9305EA2F0D6A35C6529CD220D62AFABB6" vlsit_library_entry="0" vlsit_library_cell="2" vlsit_library_instance="i72">
          <mxGeometry x="100" y="4427" width="1500" height="90" as="geometry" />
        </mxCell>
